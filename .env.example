# Either set a common root containing WBC, TBI, PBS, BMA, and TBF subfolders:
FOCUS_DATA_ROOT=/path/to/data/raw

# Or override individual datasets as needed:
# FOCUS_WBC_DIR=/path/to/WBC
# FOCUS_TBI_DIR=/path/to/TBI
# FOCUS_PBS_DIR=/path/to/PBS
# FOCUS_BMA_DIR=/path/to/BMA
# FOCUS_TBF_DIR=/path/to/TBF
